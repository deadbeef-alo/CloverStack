        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle UC-02 - Exchange Virtual Money for Chips\n\nactor Player\nparticipant \&quot;Game System\&quot; as Game\nparticipant \&quot;Exchange Service\&quot; as Exchange\nparticipant \&quot;Player Account\&quot; as Account\n\nPlayer -&gt; Game: Request exchange\nGame --&gt; Player: Display exchange packages\nPlayer -&gt; Game: Select package\nGame -&gt; Exchange: Validate package\nExchange --&gt; Game: Return package details\n\nalt Valid package\n    Game -&gt; Account: Retrieve virtual money balance\n    Account --&gt; Game: Return balance\n\n    alt Sufficient virtual money\n        Game -&gt; Exchange: Process exchange\n        Exchange -&gt; Account: Deduct virtual money\n        Exchange -&gt; Account: Credit chips\n        Exchange -&gt; Account: Record transaction\n        Account --&gt; Exchange: Confirm transaction\n        Exchange --&gt; Game: Return updated balances\n        Game --&gt; Player: Display confirmation and balances\n    else Insufficient virtual money\n        Game --&gt; Player: Display insufficient funds\n    end\n\nelse Invalid package\n    Game --&gt; Player: Display package unavailable\nend\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ClQiIRBX83L5wu7hu0bV-1">
