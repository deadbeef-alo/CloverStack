        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle UC-01 - Play Scratch-Off Tickets\n\nactor Player\nparticipant \&quot;Game System\&quot; as Game\nparticipant \&quot;Chip Account\&quot; as Account\nparticipant \&quot;Ticket Service\&quot; as Ticket\n\nPlayer -&gt; Game: Request scratch-off tickets\nGame --&gt; Player: Display available tickets\nPlayer -&gt; Game: Select ticket\nGame -&gt; Account: Check chip balance\nAccount --&gt; Game: Return balance\n\nalt Sufficient chips\n    Game -&gt; Account: Deduct ticket cost\n    Game -&gt; Ticket: Create ticket and assign outcome\n    Ticket --&gt; Game: Return ticket\n    Game --&gt; Player: Display hidden ticket\n    Player -&gt; Game: Reveal ticket areas\n    Game -&gt; Ticket: Evaluate ticket\n    Ticket --&gt; Game: Return ticket result\n\n    alt Winning ticket\n        Game -&gt; Account: Credit winning chips\n        Account --&gt; Game: Return updated balance\n        Game --&gt; Player: Display win and balance\n    else Losing ticket\n        Game --&gt; Player: Display losing result\n    end\n\nelse Insufficient chips\n    Game --&gt; Player: Display insufficient chips message\nend\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="YfT435y0rIs3ufpUFx5a-1">
