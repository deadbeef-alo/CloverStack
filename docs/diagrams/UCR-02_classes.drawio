        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\nhide circle\nskinparam linetype ortho\n\ntitle UC-02 - Exchange Virtual Money for Chips\n\n\nclass ExchangeForm {\n  exchange(amount)\n  displayInvalidAmount()\n  displayNotEnoughMoney()\n  displayExchangeSuccess()\n  showResult()\n}\n\nclass ExchangeController {\n  exchange(amount)\n}\n\nclass ExchangeService {\n  exchangeVirtualMoney(amount)\n  validateAmount(amount): Boolean\n}\n\nclass PlayerAccountRepository {\n  findByPlayerId()\n  save(account)\n}\n\nclass PlayerAccount{\n  virtualMoney: Decimal\n  chips: Integer\n  getVirtualMoney(): Decimal\n  deductVirtualMoney(amount)\n  addChips(chipAmount)\n}\n\nExchangeForm ..&gt; ExchangeController : HTTP Request\nExchangeController --&gt; ExchangeService\nExchangeService --&gt; PlayerAccountRepository\nPlayerAccountRepository ..&gt; PlayerAccount\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="7r1NYm4YiGyfXpGCUSAh-304">
