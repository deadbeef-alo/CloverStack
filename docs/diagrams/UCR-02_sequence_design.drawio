        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n\n@startuml\ntitle UC-02 - Exchange Virtual Money for Chips\n\nactor Player\nboundary \&quot;:ExchangeForm\&quot; as Form\ncontrol \&quot;:ExchangeController\&quot; as Controller\ncontrol \&quot;:ExchangeService\&quot; as Service\nentity \&quot;:PlayerAccount\&quot; as Account\n\nPlayer -&gt; Form: exchange(amount)\nForm -&gt; Controller: exchange(amount)\nController -&gt; Service: exchangeVirtualMoney(amount)\n\nService -&gt; Service: validateAmount(amount)\nService -&gt; Account: getVirtualMoney()\nAccount --&gt; Service: balance\n\nalt [amount invalid]\n    Service --&gt; Controller: invalidAmount\n    Controller --&gt; Form: displayInvalidAmount()\nelse [balance &lt; amount]\n    Service --&gt; Controller: notEnoughMoney\n    Controller --&gt; Form: displayNotEnoughMoney()\nelse [amount valid and balance sufficient]\n    Service -&gt; Account: deductVirtualMoney(amount)\n    Service -&gt; Account: addChips(chipAmount)\n    Service --&gt; Controller: exchangeSuccessful\n    Controller --&gt; Form: displayExchangeSuccess()\nend\n\nForm --&gt; Player: showResult()\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="5PT6ZvNqwhJNklDn1MtA-1">
