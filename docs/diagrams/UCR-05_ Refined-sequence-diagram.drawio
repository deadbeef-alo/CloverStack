        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nactor Player\nboundary \&quot;:ScratchOffForm\&quot; as Form\ncontrol \&quot;:PlayScratchOff\&quot; as Control\nentity \&quot;:PlayerAccount\&quot; as Account\nentity \&quot;:ScratchOffTicket\&quot; as Ticket\n\nPlayer -&gt; Form: playTicket(ticketId)\nForm -&gt; Control: playTicket(ticketId)\nControl -&gt; Account: getBalance()\nAccount --&gt; Control: balance\nControl -&gt; Ticket: getPrice()\nTicket --&gt; Control: price\n\nalt [balance &lt; price]\n    Control --&gt; Form: notEnoughMoney()\n    Form --&gt; Player: displayError()\nelse [balance &gt;= price]\n    Control -&gt; Account: deductMoney(price)\nend\n\nControl -&gt; Ticket: generateResult()\nTicket -&gt; Control: result\nControl -&gt; Control: calculatePrize(result)\n\nalt [winning ticket]\n    Control -&gt; Account: addMoney(prize)\n    Control --&gt; Form: displayWin(prize)\nelse [no win]\n    Control --&gt; Form: displayNoWin()\nend\n\nControl -&gt; Ticket: saveResult(result)\nControl -&gt; Account: saveBalance()\nForm --&gt; Player: displayTicketResult()\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="sqxHwNc2SGASLnGspJFb-1">
