        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\n\nhide circle\nskinparam linetype ortho\n\ntitle UC-05 - Play Scratch-Off Ticket\n\nclass ScratchOffForm {\n  playTicket(ticketId)\n  displayNotEnoughMoney()\n  displayResult(result, prize)\n  showResult()\n}\n\nclass ScratchOffController {\n  playTicket(ticketId)\n}\n\nclass ScratchOffService {\n  playScratchOffTicket(ticketId)\n}\n\nclass PlayerAccountRepository {\n  findByPlayerId()\n  save(account)\n}\n\nclass ScratchOffTicketRepository {\n  findById(ticketId)\n  save(ticket)\n}\n\nclass PlayerAccount {\n  virtualMoney: Decimal\n  chips: Integer\n  getVirtualMoney(): Decimal\n  deductVirtualMoney(amount)\n  addVirtualMoney(amount)\n  addChips(chipAmount)\n}\n\nclass ScratchOffTicket {\n  price: Decimal\n  getPrice(): Decimal\n  generateResult()\n  calculatePrize(result): Decimal\n}\n\nScratchOffForm ..&gt; ScratchOffController : HTTP Request\nScratchOffController --&gt; ScratchOffService\nScratchOffService --&gt; PlayerAccountRepository\nScratchOffService --&gt; ScratchOffTicketRepository\nPlayerAccountRepository ..&gt; PlayerAccount\nScratchOffTicketRepository ..&gt; ScratchOffTicket\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Mwl7Tdvk-QSKEb_gS7uf-1">
