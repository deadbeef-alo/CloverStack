        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle UC-05 - Play Scratch-Off Ticket\n\nactor Player\nboundary \&quot;:ScratchOffForm\&quot; as Form\ncontrol \&quot;:ScratchOffController\&quot; as Controller\ncontrol \&quot;:ScratchOffService\&quot; as Service\nentity \&quot;:PlayerAccount\&quot; as Account\nentity \&quot;:ScratchOffTicket\&quot; as Ticket\n\nPlayer -&gt; Form: playTicket(ticket)\nForm -&gt; Controller: playTicket(ticket)\nController -&gt; Service: playScratchOffTicket(ticket)\n\nService -&gt; Account: getVirtualMoney()\nAccount --&gt; Service: balance\nService -&gt; Ticket: getPrice()\nTicket --&gt; Service: price\n\nalt [balance &lt; price]\n    Service --&gt; Controller: notEnoughMoney\n    Controller --&gt; Form: displayNotEnoughMoney()\nelse [balance &gt;= price]\n    Service -&gt; Account: deductVirtualMoney(price)\n    Service -&gt; Ticket: generateResult()\n    Ticket --&gt; Service: result\n    Service -&gt; Ticket: calculatePrize(result)\n    Ticket --&gt; Service: prize\n\n    opt [prize &gt; 0]\n        Service -&gt; Account: addVirtualMoney(prize)\n    end\n\n    Service --&gt; Controller: result, prize\n    Controller --&gt; Form: displayResult(result, prize)\nend\n\nForm --&gt; Player: showResult()\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="1F_h1GoIaHEuCwNtbv3S-1">
